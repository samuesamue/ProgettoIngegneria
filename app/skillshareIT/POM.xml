<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>it.unibo</groupId>
        <artifactId>skillshare</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>skillshare-it</artifactId>
    <!-- packaging jar: non è la webapp, è il modulo che la testa dall'esterno -->
    <packaging>jar</packaging>

    <properties>
        <app.port>8080</app.port>
        <app.stopPort>9901</app.stopPort>
        <app.stopKey>ITstop</app.stopKey>
        <!-- Metti a false per vedere la finestra del browser durante i test -->
        <headless>true</headless>
    </properties>

    <dependencies>
        <!-- Dipendenza sul WAR del server: forza Maven a costruirlo prima di questo modulo -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>skillshare-server</artifactId>
            <version>${project.version}</version>
            <type>war</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>4.33.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- In IDE (m2e) ignora i binding di copy/Jetty: comodo quando il server
                     è già avviato a mano da IntelliJ durante lo sviluppo interattivo. -->
                <plugin>
                    <groupId>org.eclipse.m2e</groupId>
                    <artifactId>lifecycle-mapping</artifactId>
                    <version>1.0.0</version>
                    <configuration>
                        <lifecycleMappingMetadata>
                            <pluginExecutions>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>org.apache.maven.plugins</groupId>
                                        <artifactId>maven-dependency-plugin</artifactId>
                                        <versionRange>[0,)</versionRange>
                                        <goals><goal>copy</goal></goals>
                                    </pluginExecutionFilter>
                                    <action><ignore/></action>
                                </pluginExecution>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>org.eclipse.jetty.ee10</groupId>
                                        <artifactId>jetty-ee10-maven-plugin</artifactId>
                                        <versionRange>[0,)</versionRange>
                                        <goals>
                                            <goal>start</goal>
                                            <goal>stop</goal>
                                        </goals>
                                    </pluginExecutionFilter>
                                    <action><ignore/></action>
                                </pluginExecution>
                            </pluginExecutions>
                        </lifecycleMappingMetadata>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Copia il WAR del server con un nome fisso, così la config di Jetty
                 sotto non dipende dalla versione del progetto -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-app-war</id>
                        <phase>process-test-classes</phase>
                        <goals><goal>copy</goal></goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>skillshare-server</artifactId>
                                    <version>${project.version}</version>
                                    <type>war</type>
                                    <destFileName>app.war</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Avvia Jetty prima dei test, lo ferma dopo -->
            <plugin>
                <groupId>org.eclipse.jetty.ee10</groupId>
                <artifactId>jetty-ee10-maven-plugin</artifactId>
                <version>12.1.6</version>
                <configuration>
                    <!-- Permette a un modulo con packaging "jar" di usare questo plugin -->
                    <supportedPackagings>
                        <packaging>jar</packaging>
                    </supportedPackagings>
                    <webApp>
                        <war>${project.build.directory}/app.war</war>
                    </webApp>
                    <httpConnector>
                        <port>${app.port}</port>
                    </httpConnector>
                    <stopKey>${app.stopKey}</stopKey>
                    <stopPort>${app.stopPort}</stopPort>
                    <stopWait>5</stopWait>
                </configuration>
                <executions>
                    <execution>
                        <id>start-jetty</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>start</goal></goals>
                    </execution>
                    <execution>
                        <id>stop-jetty</id>
                        <phase>post-integration-test</phase>
                        <goals><goal>stop</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Esegue le classi *IT.java nella fase integration-test -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <systemPropertyVariables>
                        <app.url>http://localhost:${app.port}/</app.url>
                        <headless>${headless}</headless>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>